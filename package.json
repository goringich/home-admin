{
  "name": "project-atlas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/commercial-summary.test.mjs scripts/codex-orchestrator-projection.test.mjs scripts/service-placement-projection.test.mjs scripts/device-fleet-store.test.mjs scripts/windows-agent-contract.test.mjs scripts/build-administration-adapters.test.mjs scripts/build-architecture-universe.test.mjs",
    "architecture": "node scripts/build-architecture-universe.mjs && node scripts/enrich-architecture-universe.mjs && node scripts/apply-architecture-live-census.mjs",
    "snapshot": "node scripts/build-snapshot.mjs && npm run architecture",
    "adapters": "node scripts/build-administration-adapters.mjs",
    "dev": "npm run snapshot && npm run adapters && node scripts/dev-stack.mjs",
    "predev:ui": "npm run adapters && npm run architecture",
    "dev:ui": "vite",
    "prebuild": "npm run adapters && npm run architecture",
    "build": "tsc -b && vite build",
    "test:ai-company-browser": "node scripts/ai-company-browser-smoke.mjs",
    "build:refresh": "npm run snapshot && npm run adapters && npm run build",
    "preview": "vite preview",
    "host": "node scripts/device-fleet-host.mjs",
    "host:legacy": "node scripts/atlas-host.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
